{
  "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
  "C_Cpp.default.mergeConfigurations": true,
  "C_Cpp.default.cppStandard": "c++20",
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/src/**",
    "${workspaceFolder}/.pixi/envs/default/Library/include/**",
    "${workspaceFolder}/.artun/sdk/mavsdk/include/**"
  ],
  "cmake.useCMakePresets": "always",
  "cmake.configureOnOpen": true,
  "cmake.automaticReconfigure": true,
  "cmake.configureOnEdit": true,
  "cmake.buildDirectory": "${workspaceFolder}/.artun/build",
  "cmake.cmakePath": "${workspaceFolder}/.artun/tools/cmake/bin/cmake.exe",
  "cmake.configurePreset": "windows-x64"
}
